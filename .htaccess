Options -Indexes

# Keep environment and hidden files private.
<FilesMatch "^\.|\.env($|\.)">
    Require all denied
</FilesMatch>

# PHP endpoints and assets are served directly; frontend paths go to React.
RewriteEngine On
RewriteRule ^local-secrets(?:/|$) - [F,L]
RewriteCond %{REQUEST_URI} ^/api/ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ - [R=404,L]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.html [L]
