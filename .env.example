# In development, Vite proxies /api and /uploads to the local PHP server.
# Leave this unset for same-origin requests, including VPN access.
# VITE_API_BASE_URL=/api

# Optional only when uploads are hosted somewhere different from the API.
# VITE_PROFILE_PHOTOS_BASE_URL=http://YOUR-SHARED-SERVER-IP/BatangAI/uploads/profile_photos

GEMINI_API_KEY=
SESSION_LIFETIME_SECONDS=28800
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true
