# Local development can continue to use the PHP API.
# Production uses the Vercel Functions API on the same origin.
VITE_API_BASE_URL=http://YOUR-SHARED-SERVER-IP/BatangAI/api

# Optional only when uploads are hosted somewhere different from the API.
# VITE_PROFILE_PHOTOS_BASE_URL=http://YOUR-SHARED-SERVER-IP/BatangAI/uploads/profile_photos

# Server-only variables. Configure these in the Vercel project settings,
# not as VITE_ variables and never in client-side code.
MYSQL_URL=
SESSION_SECRET=
GEMINI_API_KEY=
BLOB_READ_WRITE_TOKEN=
DEVICE_MONITOR_TOKEN=
