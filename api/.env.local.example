# Copy this to api/.env.local for XAMPP or InfinityFree and replace the values.
# Use the MySQL host, database, and username shown in the hosting control panel.
DB_HOST=localhost
DB_NAME=batangai_db
DB_USER=root
DB_PASSWORD=
DB_PORT=3306
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GEMINI_API_KEY=
SESSION_LIFETIME_SECONDS=28800
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true
